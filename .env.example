# === KONEKSI ===
BOT_NUMBER=6282241160861
USE_PAIRING=1

# === IDENTITAS BOT ===
STORE_NAME=AfriIX
OWNER_NUMBER=6281818476378
OWNER_KEYWORDS=afrial,real,yal,mas,p

# === FITUR (1=on, 0=off) ===
ENABLE_WELCOME=1
# WELCOME_TEXT kosong = pakai default ("Eh halo ... Ini Afrial..."). Isi untuk custom.
# Contoh: WELCOME_TEXT=Eh halo 👋 Ini Afrial, ada yang bisa dibantu?
ENABLE_AI=1
ENABLE_STICKER=1
ENABLE_CS_AUTO=0
ENABLE_DASH=1
DASH_HOST=127.0.0.1
DASH_PORT=3000
DASH_TOKEN=ganti-min-8-karakter-acak

# === AI (Gemini utama, Groq cadangan) ===
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_API_URL2=https://api.groq.com/openai/v1/chat/completions
AI_MODEL2=llama-3.3-70b-versatile
AI_API_KEY2=
AI_SYSTEM_PROMPT=lihat file .env
# Vision (AI baca gambar) + Whisper (transkrip VN) — pakai KEY1 Groq
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_WHISPER_MODEL=whisper-large-v3-turbo
# Laporan harian otomatis ke owner (jam WIB)
DAILY_REPORT_HOUR=21
AUTO_AI_PRIVATE=1
AI_COOLDOWN=20
REDIRECT_MUTE_MIN=60
NUDGE_MIN=10
RESUME_MIN=30
SLEEP_START=23
SLEEP_END=5

# === SESSION / LOG ===
SESSION_DIR=./session
# fatal = hemat log (dump SessionEntry dibuang). Butuh detail Bad MAC? Set error sementara.
# LOG_VERBOSE=1 = tampilkan semua dump (debug saja, bikin log bengkak).
LOG_LEVEL=fatal

# === LISENSI PRODUKSI ===
# Generate di mesin owner: node owner-keygen.js
LICENSE_PUBLIC_KEY=
LICENSE_KEY=
TRIAL_DAYS=7

# === MODERASI + ANTI-SPAM ===
ENABLE_MODERATION=1
MOD_DELETE_GROUP=1
MOD_MAX_PRIVATE=3
SPAM_LIMIT=15
LOG_CHAT=0
# Deteksi ISI foto/video butuh webhook visual (opsional). Tanpa ini hanya teks/caption/nama file yang dinilai.
# Format webhook: POST { image: base64 } + Bearer key -> { nsfw: true/false }.
# MOD_API_URL=https://...
# MOD_API_KEY=...
